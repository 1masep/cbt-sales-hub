# Password the business owner uses to log in to the dashboard.
OWNER_PASSWORD=

# Long random strings. Make each with: openssl rand -hex 32
# SESSION_SECRET signs login cookies (changing it logs everyone out).
SESSION_SECRET=
# SALES_API_SECRET is sent by the website as: Authorization: Bearer <value>
SALES_API_SECRET=

# For "Import with AI". Create a key at https://platform.claude.com (Settings → API keys).
ANTHROPIC_API_KEY=

# The website's WooCommerce store (read-only REST API key: WooCommerce → Settings →
# Advanced → REST API → Add key, Permissions: Read). New paid orders are added
# to the sheet every 5 minutes.
WOOCOMMERCE_URL=https://cbthospitalitysupplies.com
WOOCOMMERCE_KEY=
WOOCOMMERCE_SECRET=
# Only when hosted on Vercel: protects the 5-minute check. Make one with: openssl rand -hex 32
CRON_SECRET=

# Leave empty on your computer: a built-in database is used (stored in .data/).
# When hosting, set this to a Postgres connection string (e.g. Neon).
DATABASE_URL=
